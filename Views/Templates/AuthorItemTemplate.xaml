<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="bhknjizevniciapp.Views.Templates.AuthorItemTemplate">
    <ContentView.Resources>
        <ResourceDictionary>
        <Style x:Key="AuthorContainerStyle" TargetType="Border">
            <Setter Property="HeightRequest" Value="60"/>
        </Style>


        <Style x:Key="AuthorBorderStyle" TargetType="Border">
            <Setter Property="StrokeThickness" Value="4"/>
            <Setter Property="Stroke" Value="{Binding Color}"/>

        </Style>
    </ResourceDictionary>
    </ContentView.Resources>
    <Grid
        Style="{StaticResource AuthorContainerStyle}">
        <Border
        Style="{StaticResource AuthorBorderStyle}">
            <Border.StrokeShape>
                <Ellipse/>
            </Border.StrokeShape>
            <Image
            Source="{Binding Image}"/>
        </Border>
    </Grid>
</ContentView>
