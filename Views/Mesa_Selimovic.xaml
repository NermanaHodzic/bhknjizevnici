<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="bhknjizevniciapp.Views.Mesa_Selimovic"
             Title="Meša Selimović">

    <ContentPage.Resources>
        <Style x:Key="PlayBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="HeightRequest" Value="42"/>
            <Setter Property="WidthRequest" Value="42"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="PlayIconStyle" TargetType="Path">
            <Setter Property="Fill" Value="Black"/>
            <Setter Property="Scale" Value="0.5"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="Data" Value="M0,0 L0,32 24,16z"/>
        </Style>

        <Style x:Key="MyMediaElementStyle" TargetType="toolkit:MediaElement">
            <Setter Property="WidthRequest" Value="80" />
            <Setter Property="HeightRequest" Value="80" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
            <Image Source="mesa_selimovic.jpg" Aspect="AspectFit" HeightRequest="300" Margin="0,10,0,10" />

            <Label Text="Meša Selimović" FontFamily="LobsterTwoItalic" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

            <Label Text="Meša Selimović je poznati bosanskohercegovački pisac i književnik. Rođen je 26. aprilа 1910. godine u Tuzli, Bosna i Hercegovina. Selimović je ostavio dubok i trajan uticaj na književnost svojim romanima, koji se često bave temama poput ljudske prirode, moralnih dilema i univerzalnih vrijednosti. Njegova najpoznatija knjiga je roman Derviš i smrt, koji je postao klasik svjetske književnosti. Meša Selimović je dobitnik brojnih nagrada za svoje književno stvaralaštvo." 
                   FontSize="16" FontFamily="DancingScriptSemiBold" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" Margin="10,10,10,10" />

            <Label Text="Neka od njegovih književnih djela su:"  FontFamily="LobsterTwoItalic" FontSize="16" FontAttributes="Bold" HorizontalOptions="Start" Margin="0,10,0,10" />

            <StackLayout Margin="0,0,0,20">
                <Label Text="- Tvrđava"   FontFamily="DancingScriptSemiBold" FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Magla i mjesečina" FontFamily="DancingScriptSemiBold" FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Ostrvo" FontFamily="DancingScriptSemiBold" FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Krug" FontFamily="DancingScriptSemiBold" FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Tuđa zemlja" FontFamily="DancingScriptSemiBold" FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Postanak i zla vlast" FontFamily="DancingScriptSemiBold" FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Vrijeme koje se udaljava" FontFamily="DancingScriptSemiBold" FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Magareće godine" FontFamily="DancingScriptSemiBold" FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Krug i druge pripovijetke" FontFamily="DancingScriptSemiBold" FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Tuđe pjesme" FontFamily="DancingScriptSemiBold" FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Bašta, peščanik" FontFamily="DancingScriptSemiBold" FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />

            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>