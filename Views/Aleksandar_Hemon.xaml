<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="bhknjizevniciapp.Views.Aleksandar_Hemon"
             Title="Aleksandar Hemon">

    <ContentPage.Resources>
        <Style x:Key="PlayBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="HeightRequest" Value="42"/>
            <Setter Property="WidthRequest" Value="42"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="PlayIconStyle" TargetType="Path">
            <Setter Property="Fill" Value="Black"/>
            <Setter Property="Scale" Value="0.5"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="Data" Value="M0,0 L0,32 24,16z"/>
        </Style>

        <Style x:Key="MyMediaElementStyle" TargetType="toolkit:MediaElement">
            <Setter Property="WidthRequest" Value="80" />
            <Setter Property="HeightRequest" Value="80" />
        </Style>

    </ContentPage.Resources>


    <ScrollView>
        <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
            <Image Source="aleksandar_hemon.jpg" Aspect="AspectFit" HeightRequest="300" Margin="0,10,0,10" />

            <Label Text="Aleksandar Hemon" FontFamily="LobsterTwoItalic" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

            <Label Text="Aleksandar Hemon je bosansko-američki pisac i esejista. Rođen je 9. septembra 1964. godine u Sarajevu, Bosna i Hercegovina. Hemon je poznat po svojim priznatim djelima fikcije i publicistike koja istražuju teme raseljenosti, identiteta i iskustva imigranata. Njegovo pisanje često kombinuje humor, introspekciju i društveni komentar. Među Hemonovim značajnim djelima su 'Projekt Lazarus', 'Čovjek nigdje' i 'Knjiga moga života'. Dobitnik je brojnih nagrada za svoje pisanje, uključujući MacArthur Fellowship (Genius Grant)."
                   FontSize="16" FontFamily="DancingScriptSemiBold" HorizontalOptions="FillAndExpand" HorizontalTextAlignment="Center" Margin="10,10,10,10" />

            <Label Text="Neka od njegovih značajnih književnih djela su:"  FontFamily="LobsterTwoItalic" FontSize="16" FontAttributes="Bold" HorizontalOptions="FillAndExpand"/>
            <StackLayout Margin="0,0,0,20">
                <Label Text="- Pitanje Bruna, (The Question of Bruno) roman 2004. Civitas, Sarajevo"   FontFamily="DancingScriptSemiBold" FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Čovjek bez prošlosti, (Nowhere man), roman 2005. Civitas, Sarajevo" FontFamily="DancingScriptSemiBold" FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Hemonwood, zbirka eseja objavljivanih u tjedniku BH Dani, 2007." FontFamily="DancingScriptSemiBold"  FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Ljubav i prepreke, (Love and Obstacles), kratke priče 2008. Buybook, Sarajevo" FontFamily="DancingScriptSemiBold"  FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Hemonwood 2, zbirka eseja objavljivanih u tjedniku BH Dani, 2008. Zoro, Sarajevo" FontFamily="DancingScriptSemiBold"  FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Projekt Lazarus, (The Lazarus Project), roman 2009. V.B.Z, Zagreb" FontFamily="DancingScriptSemiBold"  FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Knjiga mojih života (The Book of My Lives), Farrar, Straus and Giroux;" FontFamily="DancingScriptSemiBold"  FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
             <Label Text="Nagrade"  FontFamily="LobsterTwoItalic" FontSize="16" FontAttributes="Bold" HorizontalOptions="FillAndExpand"/>
                <Label Text="- Nagrada National Magazine za članke u The New Yorkeru 2009." FontFamily="DancingScriptSemiBold"  FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Nagrada St. Francis College Literary za knjigu Love and Obstacles 2009." FontFamily="DancingScriptSemiBold"  FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Finalist u dodjeli nagrade National Book Award National Book Critics Circle Award 2008." FontFamily="DancingScriptSemiBold"  FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Dobitnik Guggenheim Fellowship in 2003." FontFamily="DancingScriptSemiBold"  FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Finalist National Book Critics Circle Award in 2003." FontFamily="DancingScriptSemiBold"  FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Dobitnik John C. Zacharis First Book Award časopisa Ploughshares 2001." FontFamily="DancingScriptSemiBold"  FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Awarded The PEN/W. G. Sebald Award for a Fiction Writer in Mid-Caree" FontFamily="DancingScriptSemiBold"  FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                <Label Text="- Finalist for the National Magazine Award for Essay and Criticism (for 'The Aquarium')" FontFamily="DancingScriptSemiBold"  FontSize="16" Margin="0,5,0,5" HorizontalOptions="StartAndExpand" />
                
               
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
